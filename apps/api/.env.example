DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database
DB_USER=your_user
DB_PASSWORD=your_password
DB_SCHEMA=public
JWT_SECRET=your_jwt_secret
# Chave aleatória exclusiva por ambiente para derivar chaves HMAC de rate limit.
RATE_LIMIT_KEY_SECRET=your_rate_limit_key_secret
# Os contadores de rate limit ficam em memória na instância única da API e
# reinícios limpam as janelas ativas.

# Frontend autorizado no CORS.
# Local:
FRONTEND_URL=http://localhost:3000

# Politica do cookie de auth.
# Local/dev:
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# Teste rapido com Vercel + Render ou Netlify + Render:
# FRONTEND_URL=https://seu-front.vercel.app
# FRONTEND_URL=https://seu-front.netlify.app
# COOKIE_SAME_SITE=none
# COOKIE_SECURE=true

# Producao final em mesmo site/dominio controlado:
# FRONTEND_URL=https://semcomp.com.br
# COOKIE_SAME_SITE=lax
# COOKIE_SECURE=true

# Perfil HTTP descartável do ensaio na AWS:
# NODE_ENV=production
# SWAGGER_ENABLED=false
# COOKIE_SECURE=false
# COOKIE_SAME_SITE=lax

# Seed explícito e idempotente. O administrador é criado sem senha; defina-a
# posteriormente pelo fluxo interativo de bootstrap, nunca por este ambiente.
SEED_MODE=admin-only
SEED_ADMIN_NAME=Administrador Semcomp
SEED_ADMIN_CPF=52998224725
SEED_ADMIN_EMAIL=admin@example.com
