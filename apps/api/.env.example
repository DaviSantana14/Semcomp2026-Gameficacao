DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database
DB_USER=your_user
DB_PASSWORD=your_password
DB_SCHEMA=public
JWT_SECRET=your_jwt_secret
# Chave aleatória exclusiva por ambiente para derivar chaves HMAC de rate limit.
RATE_LIMIT_KEY_SECRET=your_rate_limit_key_secret
# Os contadores de rate limit ficam em memória na instância única da API e
# reinícios limpam as janelas ativas.

# Frontend autorizado no CORS.
# Local:
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# Politica do cookie de auth.
# Local/dev:
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# Teste rapido com Vercel + Render ou Netlify + Render:
# FRONTEND_URL=https://seu-front.vercel.app
# FRONTEND_URL=https://seu-front.netlify.app
# COOKIE_SAME_SITE=none
# COOKIE_SECURE=true

# Producao final em mesmo site/dominio controlado:
# FRONTEND_URL=https://semcomp.com.br
# COOKIE_SAME_SITE=lax
# COOKIE_SECURE=true

# Perfil HTTP descartável do ensaio na AWS:
# NODE_ENV=production
# SWAGGER_ENABLED=false
# COOKIE_SECURE=false
# COOKIE_SAME_SITE=lax

# Seed explícito e idempotente. Em produção, use admin-only: o administrador é
# criado sem senha e recebe-a pelo bootstrap interativo. Para desenvolvimento
# local, use demo e defina uma senha local com pelo menos 12 caracteres.
SEED_MODE=admin-only
SEED_ADMIN_NAME=Administrador Semcomp
SEED_ADMIN_CPF=52998224725
SEED_ADMIN_EMAIL=admin@example.com
# SEED_MODE=demo
# SEED_ADMIN_PASSWORD=escolha-uma-senha-local-com-12-ou-mais

# Rehearsal Marco 12 (administrator credentials must come from protected
# stdin; never place credentials, generated codes or PII in environment
# variables or reports).
# LOAD_PARTICIPANTS=150
# LOAD_HEARTBEAT_INTERVAL_MS=60000
# LOAD_HEARTBEAT_WINDOW_MS=130000
# LOAD_MARCO12=true
# LOAD_CLAIM_CODE_ACTION_ID=existing-action-id
# LOAD_CLAIM_CODE_QUANTITY=500
# LOAD_REPORT_PATH=artifacts/marco-12-load-report.json
# The rehearsal enforces 500 Claim Codes per batch/PDF/ZIP, 50,000 rows and
# 25 MiB per CSV, five export starts/two bulk starts per administrator per
# minute, and one QR generation per process. Security metrics keep only
# aggregate 401/403/429 minute buckets for 30 days; thresholds are 20/10/5
# over five minutes.
