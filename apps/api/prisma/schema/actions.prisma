enum ActionType {
  CHECKIN
  ATTENDANCE
  STAND_VISIT
  EASTER_EGG
  QUESTION
  DYNAMIC
  BONUS
}

enum PointEventKind {
  CREDIT
  DEBIT
}

enum PointEventSource {
  ACTION_REDEEM
  ADMIN_GRANT
  ADMIN_ADJUST
  REWARD_REDEMPTION
}

enum ActionRedemptionMethod {
  DIRECT
  REUSABLE_CODE
  CLAIM_CODE
  LEGACY_UNKNOWN
}

enum ClaimCodeBulkOutcome {
  CHANGED
  ALREADY_IN_STATE
  ALREADY_USED
  NOT_FOUND
}

model Action {
  id           String       @id @default(cuid())
  name         String
  description  String?
  type         ActionType
  code         String?      @unique
  points       Int
  isActive     Boolean      @default(true)
  isCodeActive Boolean      @default(false)
  pointEvents  PointEvent[]
  claimCodes   ClaimCode[]
  claimCodeBatches ClaimCodeBatch[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model ClaimCode {
  id                 String      @id @default(cuid())
  code               String      @unique
  actionId           String
  isUsed             Boolean     @default(false)
  isActive           Boolean     @default(true)
  usedById           String?
  usedAt             DateTime?
  batchId            String?
  action             Action      @relation(fields: [actionId], references: [id], onDelete: Restrict)
  usedBy             User?       @relation(fields: [usedById], references: [id], onDelete: Restrict)
  batch              ClaimCodeBatch? @relation(fields: [batchId], references: [id], onDelete: Restrict)
  bulkOperationItems ClaimCodeBulkOperationItem[]
  createdAt          DateTime    @default(now())
  pointEvent         PointEvent?

  @@index([actionId])
  @@index([usedById])
  @@index([actionId, isUsed, isActive, createdAt])
  @@index([batchId, createdAt])
}

model ClaimCodeBatch {
  id                String      @id @default(uuid())
  actionId          String
  createdByAdminId  String
  requestedQuantity Int
  createdQuantity   Int
  reason            String
  requestId         String      @unique
  action            Action      @relation(fields: [actionId], references: [id], onDelete: Restrict)
  createdByAdmin    User        @relation("ClaimCodeBatchCreatedBy", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  claimCodes        ClaimCode[]
  createdAt         DateTime    @default(now())

  @@index([actionId, createdAt])
  @@index([createdByAdminId, createdAt])
}

model ClaimCodeBulkOperation {
  id             String                       @id @default(uuid())
  actorAdminId   String
  targetIsActive Boolean
  reason         String
  requestId      String                       @unique
  selectedCount  Int
  changedCount   Int
  unchangedCount Int
  usedCount      Int
  notFoundCount  Int
  actorAdmin     User                         @relation("ClaimCodeBulkOperationActor", fields: [actorAdminId], references: [id], onDelete: Restrict)
  items          ClaimCodeBulkOperationItem[]
  createdAt      DateTime                     @default(now())

  @@index([actorAdminId, createdAt])
  @@index([createdAt])
}

model ClaimCodeBulkOperationItem {
  operationId          String
  requestedClaimCodeId String
  claimCodeId          String?
  maskedCode           String?
  outcome              ClaimCodeBulkOutcome
  operation            ClaimCodeBulkOperation @relation(fields: [operationId], references: [id], onDelete: Restrict)
  claimCode            ClaimCode?             @relation(fields: [claimCodeId], references: [id], onDelete: Restrict)

  @@id([operationId, requestedClaimCodeId])
  @@index([claimCodeId])
}

model PointEvent {
  id                 String                  @id @default(cuid())
  userId             String
  actionId           String?
  points             Int
  xpDelta            Int                     @default(0)
  kind               PointEventKind
  source             PointEventSource
  redemptionMethod   ActionRedemptionMethod?
  claimCodeId        String?                 @unique
  auditEventId       String?
  rewardRedemptionId String?
  actorAdminId       String?
  idempotencyKey     String?                 @unique
  reversedEventId    String?                 @unique
  description        String?
  user               User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  action             Action?                 @relation(fields: [actionId], references: [id], onDelete: SetNull)
  claimCode          ClaimCode?              @relation(fields: [claimCodeId], references: [id], onDelete: Restrict)
  auditEvent         AdminAuditEvent?        @relation(fields: [auditEventId], references: [id], onDelete: Restrict)
  rewardRedemption   RewardRedemption?       @relation(fields: [rewardRedemptionId], references: [id], onDelete: Restrict)
  actorAdmin         User?                   @relation("PointEventActor", fields: [actorAdminId], references: [id], onDelete: Restrict)
  reversedEvent      PointEvent?             @relation("PointEventReversal", fields: [reversedEventId], references: [id], onDelete: Restrict)
  reversal           PointEvent?             @relation("PointEventReversal")
  createdAt          DateTime                @default(now())

  @@index([userId])
  @@index([actionId])
  @@index([createdAt])
  @@index([redemptionMethod, createdAt])
  @@index([auditEventId])
  @@index([rewardRedemptionId])
  @@index([actorAdminId])
}
