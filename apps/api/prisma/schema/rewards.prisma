enum RedemptionStatus {
  PENDING
  DELIVERED
  CANCELLED
}

model Reward {
  id           String             @id @default(cuid())
  name         String
  description  String?
  costInPoints Int
  stock        Int
  isActive     Boolean            @default(true)
  imageUrl     String?
  redemptions  RewardRedemption[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model RewardRedemption {
  id                 String           @id @default(cuid())
  userId             String
  rewardId           String
  pointsSpent        Int
  status             RedemptionStatus @default(PENDING)
  deliveredAt        DateTime?
  deliveredByAdminId String?
  cancelledAt        DateTime?
  cancelledByAdminId String?
  user               User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  reward             Reward           @relation(fields: [rewardId], references: [id], onDelete: Restrict)
  deliveredByAdmin   User?            @relation("RewardRedemptionDeliveredBy", fields: [deliveredByAdminId], references: [id], onDelete: Restrict)
  cancelledByAdmin   User?            @relation("RewardRedemptionCancelledBy", fields: [cancelledByAdminId], references: [id], onDelete: Restrict)
  pointEvents        PointEvent[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([userId])
  @@index([rewardId])
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([deliveredByAdminId])
  @@index([cancelledByAdminId])
}
