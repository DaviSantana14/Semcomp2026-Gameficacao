enum UserRole {
  PARTICIPANT
  ADMIN
}

enum AdminProfile {
  GENERAL
  SHOP
  ACTIVITIES
}

model User {
  id                       String             @id @default(cuid())
  name                     String
  cpf                      String             @unique
  email                    String             @unique
  role                     UserRole           @default(PARTICIPANT)
  points                   Int                @default(0)
  xp                       Int                @default(0)
  level                    Int                @default(1)
  isActive                 Boolean            @default(true)
  lastLoginAt              DateTime?
  passwordHash             String?
  passwordChangedAt        DateTime?
  adminProfile             AdminProfile?
  passwordResetRequired    Boolean            @default(false)
  passwordResetExpiresAt   DateTime?
  pointEvents              PointEvent[]
  rewardRedemptions        RewardRedemption[]
  auditEventsAsActor       AdminAuditEvent[]  @relation("AuditActor")
  auditEventsAsParticipant AdminAuditEvent[]  @relation("AuditParticipant")
  pointEventsAsActor       PointEvent[]       @relation("PointEventActor")
  deliveredRedemptions     RewardRedemption[] @relation("RewardRedemptionDeliveredBy")
  cancelledRedemptions     RewardRedemption[] @relation("RewardRedemptionCancelledBy")
  claimCodeBatchesCreated  ClaimCodeBatch[]   @relation("ClaimCodeBatchCreatedBy")
  claimCodeBulkOperations  ClaimCodeBulkOperation[] @relation("ClaimCodeBulkOperationActor")
  usedClaimCodes           ClaimCode[]
  sessions                 UserSession[]
  adminActivations         AdminActivation[]  @relation("AdminActivationSubject")
  adminActivationsCreated  AdminActivation[]  @relation("AdminActivationCreator")
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  @@index([role, adminProfile, isActive, createdAt])
}

model AdminActivation {
  id               String   @id @default(cuid())
  adminUserId      String
  codeHash         String   @unique
  expiresAt        DateTime
  usedAt           DateTime?
  revokedAt        DateTime?
  createdByAdminId String
  createdAt        DateTime @default(now())
  adminUser        User     @relation("AdminActivationSubject", fields: [adminUserId], references: [id], onDelete: Restrict)
  createdByAdmin   User     @relation("AdminActivationCreator", fields: [createdByAdminId], references: [id], onDelete: Restrict)

  @@index([adminUserId, createdAt])
  @@index([expiresAt])
}
