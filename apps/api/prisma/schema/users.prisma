enum UserRole {
  PARTICIPANT
  ADMIN
}

model User {
  id                       String             @id @default(cuid())
  name                     String
  cpf                      String             @unique
  email                    String             @unique
  role                     UserRole           @default(PARTICIPANT)
  points                   Int                @default(0)
  xp                       Int                @default(0)
  level                    Int                @default(1)
  isActive                 Boolean            @default(true)
  lastLoginAt              DateTime?
  passwordHash             String?
  passwordChangedAt        DateTime?
  pointEvents              PointEvent[]
  rewardRedemptions        RewardRedemption[]
  auditEventsAsActor       AdminAuditEvent[]  @relation("AuditActor")
  auditEventsAsParticipant AdminAuditEvent[]  @relation("AuditParticipant")
  pointEventsAsActor       PointEvent[]       @relation("PointEventActor")
  deliveredRedemptions     RewardRedemption[] @relation("RewardRedemptionDeliveredBy")
  cancelledRedemptions     RewardRedemption[] @relation("RewardRedemptionCancelledBy")
  usedClaimCodes           ClaimCode[]
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
}
