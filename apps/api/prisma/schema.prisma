// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PARTICIPANT
  ADMIN
}

enum ActionType {
  CHECKIN
  ATTENDANCE
  STAND_VISIT
  EASTER_EGG
  QUESTION
  DYNAMIC
  BONUS
}

enum PointEventKind {
  CREDIT
  DEBIT
}

enum PointEventSource {
  ACTION_REDEEM
  ADMIN_GRANT
  ADMIN_ADJUST
  REWARD_REDEMPTION
}

enum RedemptionStatus {
  PENDING
  DELIVERED
  CANCELLED
}

enum ActionRedemptionMethod {
  DIRECT
  REUSABLE_CODE
  CLAIM_CODE
  LEGACY_UNKNOWN
}

model User {
  id                String             @id @default(cuid())
  name              String
  cpf               String             @unique
  email             String             @unique
  role              UserRole           @default(PARTICIPANT)
  points            Int                @default(0)
  xp                Int                @default(0)
  level             Int                @default(1)
  isActive          Boolean            @default(true)
  lastLoginAt       DateTime?
  pointEvents       PointEvent[]
  rewardRedemptions RewardRedemption[]
  usedClaimCodes     ClaimCode[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Action {
  id          String       @id @default(cuid())
  name        String
  description String?
  type        ActionType
  code        String?      @unique
  points      Int
  isActive    Boolean      @default(true)
  isCodeActive Boolean     @default(false)
  pointEvents PointEvent[]
  claimCodes  ClaimCode[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model ClaimCode {
  id       String    @id @default(cuid())
  code     String    @unique
  actionId String
  isUsed   Boolean   @default(false)
  isActive Boolean   @default(true)
  usedById String?
  usedAt   DateTime?
  action   Action    @relation(fields: [actionId], references: [id], onDelete: Restrict)
  usedBy   User?     @relation(fields: [usedById], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  pointEvent PointEvent?

  @@index([actionId])
  @@index([usedById])
  @@index([actionId, isUsed, isActive, createdAt])
}

model PointEvent {
  id          String           @id @default(cuid())
  userId      String
  actionId    String?
  points      Int
  kind        PointEventKind
  source      PointEventSource
  redemptionMethod ActionRedemptionMethod?
  claimCodeId String?          @unique
  description String?
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  action      Action?          @relation(fields: [actionId], references: [id], onDelete: SetNull)
  claimCode   ClaimCode?       @relation(fields: [claimCodeId], references: [id], onDelete: Restrict)
  createdAt   DateTime         @default(now())

  @@index([userId])
  @@index([actionId])
  @@index([createdAt])
  @@index([redemptionMethod, createdAt])
}

model Reward {
  id          String             @id @default(cuid())
  name        String
  description String?
  costInPoints Int
  stock       Int
  isActive    Boolean            @default(true)
  imageUrl    String?
  redemptions RewardRedemption[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model RewardRedemption {
  id          String           @id @default(cuid())
  userId      String
  rewardId    String
  pointsSpent Int
  status      RedemptionStatus @default(PENDING)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward      Reward           @relation(fields: [rewardId], references: [id], onDelete: Restrict)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([userId])
  @@index([rewardId])
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
}
