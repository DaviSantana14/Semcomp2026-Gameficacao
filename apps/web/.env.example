# A URL publica e incorporada durante o build da imagem Docker. Altere o
# build-arg e reconstrua a imagem para usar outro valor.
NEXT_PUBLIC_API_URL=/api

# Deixe true quando o frontend consegue ler o cookie access_token no mesmo site.
# Para teste Vercel + Render, use false porque o cookie fica no dominio da API.
AUTH_PROXY_ENABLED=true
