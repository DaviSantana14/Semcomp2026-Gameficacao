COMPOSE_PROJECT_NAME=semcomp
POSTGRES_DB=your_database
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password
POSTGRES_PORT=5432

# Optional Marco 12 load rehearsal settings. Keep credentials and generated
# Claim Codes out of the environment; the load script reads administrator
# credentials from protected stdin and writes only aggregate metrics.
# LOAD_PARTICIPANTS=150
# LOAD_HEARTBEAT_INTERVAL_MS=60000
# LOAD_HEARTBEAT_WINDOW_MS=130000
# LOAD_MARCO12=true
# LOAD_CLAIM_CODE_ACTION_ID=existing-action-id
# LOAD_CLAIM_CODE_QUANTITY=500
# LOAD_REPORT_PATH=artifacts/marco-12-load-report.json
#
# Marco 12 limits: 500 Claim Codes per batch/PDF/ZIP, 50,000 CSV rows and
# 25 MiB per CSV; two CSV generations and one QR generation per process;
# five export starts and two bulk starts per administrator per minute.
# Security metrics retain only aggregate 401/403/429 minute buckets for 30 days
# and use 20/10/5 thresholds over five minutes.
