# Perfil local do ensaio. Todos os valores são fictícios e descartáveis.
# Nunca reutilize este arquivo em produção. No ensaio AWS, substitua os
# secrets locais por SecureStrings fornecidos via SSM.

# Compose e PostgreSQL local.
COMPOSE_PROJECT_NAME=semcomp-rehearsal-local
POSTGRES_DB=semcomp_rehearsal
POSTGRES_USER=semcomp_rehearsal
POSTGRES_PASSWORD=discarded-local-db-secret
POSTGRES_SCHEMA=public

# API/NestJS e Prisma. O Compose deriva DB_HOST=postgres, DB_PORT=5432 e as
# variáveis DB_NAME/DB_USER/DB_PASSWORD/DB_SCHEMA dos valores PostgreSQL acima;
# nenhuma porta do banco é publicada no host.
JWT_SECRET=discarded-local-jwt-secret
RATE_LIMIT_KEY_SECRET=discarded-local-rate-limit-secret
FRONTEND_URL=http://localhost
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
NODE_ENV=production
SWAGGER_ENABLED=false

# Seed idempotente. O CPF tem 11 dígitos apenas para satisfazer o formato;
# é deliberadamente inválido e não representa uma pessoa real.
SEED_MODE=admin-only
SEED_ADMIN_NAME=Administrador de Ensaio Local
SEED_ADMIN_CPF=00000000000
SEED_ADMIN_EMAIL=admin@rehearsal.invalid

# Next.js: a URL é incorporada durante o build; o proxy de autenticação fica
# ativo no runtime para o stack publicado na mesma origem.
NEXT_PUBLIC_API_URL=/api
AUTH_PROXY_ENABLED=true

# A senha administrativa nunca pertence ao ambiente. Defina-a somente depois
# do seed, pelo fluxo interativo de bootstrap via Session Manager.
